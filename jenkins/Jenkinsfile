pipeline {
  agent any
  parameters {
    choice(name: 'MANIFEST', choices: ['valid_intra_domain.yaml', 'invalid_cross_domain_db.yaml', 'valid_cross_domain_api.yaml'], description: 'Manifest to assert')
  }
  stages {
    stage('Checkout') { steps { echo 'Repository content is mounted into the demonstrator image.' } }
    stage('Build / Prepare') { steps { sh "test -f /workspace/manifests/${params.MANIFEST}" } }
    stage('Architecture Assertion') {
      steps {
        script {
          def response = sh(script: "curl -sS -w '\\n%{http_code}' -X POST -H 'Content-Type: application/json' --data \"\$(python3 -c 'import sys,yaml,json; print(json.dumps(yaml.safe_load(open(sys.argv[1]))))' /workspace/manifests/${params.MANIFEST})\" http://assertion-api:8000/architecture/assertions", returnStdout: true).trim()
          def lines = response.readLines(); def status = lines[-1]; def body = lines[0..-2].join('\n')
          echo body
          if (status != '200') { error("Architecture assertion rejected (HTTP ${status})") }
        }
      }
    }
    stage('Deploy / demo') { steps { echo 'Architecture assertion passed - deployment would proceed' } }
  }
}
