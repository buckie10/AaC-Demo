pipeline {
  agent any
  parameters {
    choice(name: 'MANIFEST', choices: ['valid_intra_domain.yaml', 'invalid_cross_domain_db.yaml', 'valid_cross_domain_api.yaml'], description: 'Manifest to assert')
  }
  stages {
    stage('Checkout') { steps { echo 'Repository content is mounted into the demonstrator image.' } }
    stage('Build / Prepare') {
      steps {
        sh """
          set -eu
          rm -rf architecture-assertion
          mkdir -p architecture-assertion
          cp /workspace/manifests/${params.MANIFEST} architecture-assertion/manifest.yaml
          python3 /usr/local/bin/manifest_to_json.py architecture-assertion/manifest.yaml > architecture-assertion/request.json
        """
      }
    }
    stage('Architecture Assertion') {
      steps {
        script {
          def status = sh(script: "curl -sS -X POST -H 'Content-Type: application/json' --data-binary @architecture-assertion/request.json -o architecture-assertion/architecture-assertion.json -w '%{http_code}' http://assertion-api:8000/architecture/assertions", returnStdout: true).trim()
          writeFile file: 'architecture-assertion/http-status.txt', text: status
          sh "python3 /usr/local/bin/render_report.py architecture-assertion/architecture-assertion.json architecture-assertion/manifest.yaml architecture-assertion/report.html ${status}"
          echo readFile('architecture-assertion/architecture-assertion.json')
          env.ASSERTION_HTTP_STATUS = status
        }
      }
    }
    stage('Archive Architecture Report') {
      steps {
        archiveArtifacts artifacts: 'architecture-assertion/**', fingerprint: true
      }
    }
    stage('Deployment Gate') {
      steps {
        script {
          if (env.ASSERTION_HTTP_STATUS != '200') {
            error("Architecture assertion rejected (HTTP ${env.ASSERTION_HTTP_STATUS}); report archived")
          }
        }
      }
    }
    stage('Deploy / demo') { steps { echo 'Architecture assertion passed - deployment would proceed' } }
  }
}
